#!/bin/bash

HEADER="enter=󰿄  M-BS=Delete  C-R=rename"

selected_session=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | fzf \
  --header "$HEADER" \
  --border rounded \
  --height 100% \
  --color 'pointer:10,spinner:92,marker:46,bg+:-1' \
  --bind 'change:first' \
  --bind '?:toggle-preview' \
  --bind 'ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
  --bind "alt-bspace:execute(tmux kill-session -t {})+reload(tmux list-sessions -F '#{session_name}')" \
  --bind "ctrl-r:execute(
      printf 'New name: ' >&2;
      IFS= read -r name;
      [ -n \"\$name\" ] && tmux rename-session -t {} \"\$name\"
    )+reload(tmux list-sessions -F '#{session_name}')" \
  --preview 'tmux capture-pane -ep -t {}:')

[[ -z "$selected_session" ]] && exit 0

exec tconnect "$selected_session"
