#!/bin/bash

pick_session() {
  {
    printf "%s\n" ". .dotfiles" ". .config/nvim"
    fd --base-directory="$HOME/apps" --exact-depth=2 --type d --color=never --format 'apps {}' --no-ignore
  } | fzf \
    --border rounded \
    --scheme path \
    --height 100% \
    --with-nth 2
}

selected="${1:-$(pick_session)}"
[[ -z "$selected" ]] && exit 0

read -r base path <<< "$selected"

selected_path="$HOME/$base/$path"
selected_name="${selected_path##*/}"

exec tconnect "$selected_name" "$selected_path"
