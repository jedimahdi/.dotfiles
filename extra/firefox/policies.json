{
  "policies": {
    "DisableAppUpdate": true,
    "DisableFirefoxStudies": true,
    "DisableRemoteImprovements": true,
    "DisableFeedbackCommands": true,
    "DisableSetDesktopBackground": true,
    "DisableFirefoxScreenshots": true,
    "DisableTelemetry": true,
    "DontCheckDefaultBrowser": true,
    "SkipTermsOfUse": true,
    "NoDefaultBookmarks": true,
    "CaptivePortal": false,
    "NetworkPrediction": false,

    "3rdparty": {
      "Extensions": {
        "uBlock0@raymondhill.net": {
          "adminSettings": {
            "userSettings": {
              "uiTheme": "dark",
              "uiAccentCustom": false,
              "cloudStorageEnabled": false,
              "externalLists": "https://raw.githubusercontent.com/DandelionSprout/adfilt/master/LegitimateURLShortener.txt"
            },
            "selectedFilterLists": [
              "user-filters",
              "adguard-generic",
              "adguard-spyware-url",
              "easylist",
              "easyprivacy",
              "ublock-filters",
              "ublock-badware",
              "ublock-privacy",
              "ublock-quick-fixes",
              "ublock-unbreak",
              "urlhaus-1",
              "curben-phishing",
              "plowe-0",
              "IRN-0",
              "https://raw.githubusercontent.com/DandelionSprout/adfilt/master/LegitimateURLShortener.txt"
            ]
          }
        }
      }
    },

    "ExtensionSettings": {
      "*": {
        "installation_mode": "blocked"
      },
      "uBlock0@raymondhill.net": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "private_browsing": true
      },
      "addon@darkreader.org": {
        "installation_mode": "normal_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/darkreader/latest.xpi"
      },
      "vimium-c@gdh1995.cn": {
        "installation_mode": "normal_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/vimium-c/latest.xpi"
      }
    },

    "SearchEngines": {
      "PreventInstalls": true,
      "Remove": ["Wikipedia (en)", "Google", "Perplexity", "Bing", "DuckDuckGo"],
      "Default": "Google Web",
      "Add": [
        {
          "Name": "Google Web",
          "Alias": "@g",
          "Method": "GET",
          "URLTemplate": "https://www.google.com/search?q={searchTerms}&udm=14&hl=en&pws=0"
        },
        {
          "Name": "DuckDuckGo NoAI",
          "Alias": "@d",
          "Method": "POST",
          "URLTemplate": "https://noai.duckduckgo.com/",
          "PostData": "q={searchTerms}&kp=-2"
        },
        {
          "Name": "Wiktionary",
          "Alias": "@w",
          "Method": "GET",
          "URLTemplate": "https://en.wiktionary.org/wiki/Special:Search?search={searchTerms}"
        },
        {
          "Name": "Arch Wiki",
          "URLTemplate": "https://wiki.archlinux.org/index.php?search={searchTerms}",
          "Method": "GET",
          "Alias": "@aw",
          "Description": "Search the Arch Linux Wiki"
        },
        {
          "Name": "Arch Packages",
          "Alias": "@ap",
          "Method": "GET",
          "URLTemplate": "https://archlinux.org/packages/?q={searchTerms}"
        },
        {
          "Name": "Gentoo Wiki",
          "URLTemplate": "https://wiki.gentoo.org/index.php?search={searchTerms}&go=Go",
          "Method": "GET",
          "Alias": "@gw"
        },
        {
          "Name": "YouTube",
          "URLTemplate": "https://www.youtube.com/results?search_query={searchTerms}",
          "Method": "GET",
          "Alias": "@y"
        },
        {
          "Name": "X",
          "Alias": "@x",
          "Method": "GET",
          "URLTemplate": "https://x.com/search?q={searchTerms}&src=typed_query"
        },
        {
          "Name": "SearXNG",
          "Alias": "@sx",
          "Method": "POST",
          "URLTemplate": "https://searx.be/search",
          "PostData": "q={searchTerms}&language=en-US&safesearch=0"
        }
      ]
    },

    "FirefoxHome": {
      "Weather": false,
      "TopSites": false,
      "Highlights": false,
      "Stories": false,
      "Pocket": false,
      "SponsoredTopSites": false,
      "SponsoredStories": false,
      "SponsoredPocket": false
    },
    "FirefoxSuggest": {
      "WebSuggestions": false,
      "SponsoredSuggestions": false,
      "ImproveSuggest": false
    },
    "GenerativeAI": {
      "Enabled": false
    },
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false,
      "FirefoxLabs": false,
      "Locked": true
    }
  }
}
